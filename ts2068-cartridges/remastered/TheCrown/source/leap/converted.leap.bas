PROC QZREAD(QZARG):
QZK = 0
QZT = USR(62464)
IF QZT = 255 THEN
PRINT "OUT OF DATA"
END
ENDIF
IF QZT = 0 THEN
QZN = USR(62464)
IF QZN >= 128 THEN
QZN = QZN - 256
ENDIF
ENDIF
IF QZT = 1 THEN
