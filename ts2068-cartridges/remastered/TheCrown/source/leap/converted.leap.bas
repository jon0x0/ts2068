ENDIF
ENDIF
ENDP
PROC QZRESTORE(QZRL):
QZLO = 0
QZHI = QZCOUNT-1
QZO = QZBASE+QZEND
QZRLOOP:
IF QZLO > QZHI THEN GOTO QZRFOUND
QZMID = DIV(QZLO+QZHI,2)
QZIX = QZBASE+2+4*QZMID
POKE 63456,MOD(QZIX,256)
POKE 63457,DIV(QZIX,256)
QZLINE = USR(62464)+256*USR(62464)
QZOFF = USR(62464)+256*USR(62464)
IF QZLINE >= QZRL THEN
QZO = QZBASE+QZOFF
QZHI = QZMID-1
ELSE
QZLO = QZMID+1
ENDIF
GOTO QZRLOOP
QZRFOUND:
POKE 63456,MOD(QZO,256)
POKE 63457,DIV(QZO,256)
ENDP
